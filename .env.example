# =================================================================
# TikTak (tik.tak.md) - Environment Configuration
# =================================================================

# --- Application ---
APP_NAME=TikTak
APP_TAGLINE="Universal Student Gateway"
APP_DOMAIN=tik.tak.md

# --- Database ---
DB_DRIVER=pocketbase # 'pocketbase' (recommended) or 'mysql'

# --- PocketBase Configuration ---
POCKETBASE_URL=https://db.zece.info
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your_pocketbase_admin_password

# --- Legacy MySQL Database (only needed if DB_DRIVER=mysql) ---
DB_HOST=85.120.144.58
DB_PORT=3306
DB_NAME=tiktak_db
DB_USER=tiktak_user
DB_PASS=your_strong_db_password

# --- MinIO / S3 Object Storage ---
MINIO_ENDPOINT=minio-f4qsjb22cxs0wdyypygkj480.85.120.144.58.sslip.io
MINIO_PORT=80
MINIO_USE_SSL=false
MINIO_BUCKET=tiktak
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=ChangeThisPassword123!
MINIO_REGION=us-east-1

# --- Initial Administrator Account (Seed) ---
ADMIN_USERNAME=prof
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME="Professor"
